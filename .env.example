# ============================================================
# 企业知识库智能体 - 环境变量配置模板
# 用法：复制本文件为 .env，填入你自己的 API Key
#   cp .env.example .env    （Windows 命令行用：copy .env.example .env）
# .env 已被 .gitignore 忽略，不会提交到 Git，放心填写
# ============================================================

# ---------- 硅基流动 API（必填）----------
# 注册地址：https://cloud.siliconflow.cn
# 注册后进入「API 密钥」页面新建密钥，复制 sk- 开头的字符串填到下面
SILICONFLOW_API_KEY=sk-在这里替换成你的密钥

# ---------- 模型 ID（一般不用改，平台调整时再换）----------
LLM_MODEL=deepseek-ai/DeepSeek-V3
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---------- 文档切分参数（字符数）----------
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ---------- 检索参数 ----------
VECTOR_TOP_K=20          # 向量检索候选数
BM25_TOP_K=20            # 关键词检索候选数
FINAL_TOP_K=5            # 重排序后最终喂给大模型的片段数
RERANK_SCORE_THRESHOLD=0.3   # 重排序最高分低于此值则判定"知识库无相关内容"

# ---------- Agent 参数 ----------
AGENT_MAX_ROUNDS=6       # Agent 决策循环最大轮数（每轮一次模型调用，防止死循环）
